---
// Shared shop content for the two confirmation pages
// (thank-you-newsletter.astro, thank-you-seasonal-menus.astro) — only the
// confirmation headline above this differs between them.
//
// Product links are ShopMy tracking URLs (not plain retailer links) so
// clicks are attributed back to Lauren's ShopMy account for commission
// credit, per her ShopMy collections export. "View full collection" points
// at the collections tab of her ShopMy shop — ShopMy doesn't expose a
// separate deep link per collection in that export, so all four sections
// share the same URL; a shopper lands there and picks the shelf they want.
import ShopTile from './ShopTile.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  // Photo for the closing Instagram-band slot. Optional — pages that don't
  // have a spare photo for it (e.g. thank-you-seasonal-menus, whose hero
  // photo is still doing duty up top) fall back to the placeholder box.
  instagramImage?: ImageMetadata;
}

const { instagramImage } = Astro.props;

