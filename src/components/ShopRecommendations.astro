---
<section class="shop-section wrap" aria-labelledby="flagship-heading">
  <div class="shop-head is-flagship">
    <div>
      <h2 id="flagship-heading">Our home systems</h2>
    </div>
    <a class="cta-button is-small" href={COLLECTIONS_URL} target="_blank" rel="noopener noreferrer">View full collection<span aria-hidden="true"> →</span></a>
  </div>

  <div class="shop-flagship">
    <a class="shop-flagship-feature" href={flagshipFeature.href} target="_blank" rel="noopener noreferrer">
      <div class="shop-flagship-photo">
        <img src={flagshipFeature.image} alt={flagshipFeature.name} loading="lazy" decoding="async" />
      </div>
      <div class="shop-flagship-info">
        <span class="shop-flagship-name">{flagshipFeature.name}</span>
        <p class="shop-flagship-blurb">{flagshipFeature.blurb}</p>
      </div>
    </a>
    <div class="shop-flagship-picks">
      {flagshipPicks.map((pick) => (
        <a class="shop-flagship-pick" href={pick.href} target="_blank" rel="noopener noreferrer">
          <div class="shop-flagship-pick-photo">
            <img src={pick.image} alt={pick.name} loading="lazy" decoding="async" />
          </div>
          <span class="shop-flagship-pick-name">{pick.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="shop-section wrap" aria-labelledby="homeschool-heading">
  <div class="shop-head">
    <div>
      <h2 id="homeschool-heading">Homeschool favorites</h2>
    </div>
    <a class="cta-button is-small" href={COLLECTIONS_URL} target="_blank" rel="noopener noreferrer">View full collection<span aria-hidden="true"> →</span></a>
  </div>
  <div class="shop-grid is-cols-4">
    {homeschoolItems.map((item) => <ShopTile name={item.name} href={item.href} image={item.image} />)}
  </div>
</section>

<section class="shop-section wrap" aria-labelledby="home-heading">
  <div class="shop-head">
    <div>
      <h2 id="home-heading">Home favorites</h2>
    </div>
    <a class="cta-button is-small" href={COLLECTIONS_URL} target="_blank" rel="noopener noreferrer">View full collection<span aria-hidden="true"> →</span></a>
  </div>
  <div class="shop-grid is-cols-4">
    {homeItems.map((item) => <ShopTile name={item.name} href={item.href} image={item.image} />)}
  </div>
</section>

<section class="shop-section wrap" aria-labelledby="mom-heading">
  <div class="shop-head">
    <div>
      <h2 id="mom-heading">Mom favorites</h2>
    </div>
    <a class="cta-button is-small" href={COLLECTIONS_URL} target="_blank" rel="noopener noreferrer">View full collection<span aria-hidden="true"> →</span></a>
  </div>
  <div class="shop-grid is-cols-3">
    {momItems.map((item) => <ShopTile name={item.name} href={item.href} image={item.image} />)}
  </div>
</section>

<div class="reading-band wrap">
  <div>
    <p class="shop-kicker">What I'm reading</p>
    <p class="reading-tagline">Four pages a night, most nights.</p>
  </div>
  <ul class="reading-list">
    {readingItems.map((book) => (
      <li>
        <a href={book.href} target="_blank" rel="noopener noreferrer">
          <img class="reading-cover" src={book.image} alt="" loading="lazy" decoding="async" />
          <span>
            <span class="reading-title">{book.title}</span>
            <span class="reading-author">{book.author} · Amazon</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>

<section class="instagram-band">
  <div class="wrap">
    <div>
      <p class="lede-title">Most days, the rhythms show up on Instagram first.</p>
      <p class="lede-copy">Come find me there — I'd love to know which part of your evening feels hardest.</p>
      <a class="cta-button is-outline" href="https://www.instagram.com/meaningfullymessy" target="_blank" rel="noopener noreferrer">@meaningfullymessy</a>
    </div>
    <div class="instagram-photo">
      {instagramImage ? (
        <Image src={instagramImage} alt="Lauren" />
      ) : (
        <div class="shop-placeholder"><span>Instagram photo</span></div>
      )}
    </div>
    <p class="affiliate-note">Some links are affiliate links — I only ever share what's already in our house.</p>
  </div>
</section>
