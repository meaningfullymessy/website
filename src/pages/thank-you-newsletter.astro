---
import Layout from '../layouts/Layout.astro';
import ShopRecommendations from '../components/ShopRecommendations.astro';
import { Image } from 'astro:assets';
import portraitImage from '../assets/images/portrait.jpg';
import portraitLargeImage from '../assets/images/portrait-large.jpg';
---
<Layout
  title="You're in — Meaningfully Messy"
  description="Thanks for joining the weekly note. While your first issue lands, here's what actually gets used around our house."
>
  <section class="hero wrap" aria-labelledby="confirm-heading">
    <div>
      <hr class="kicker-rule" />
      <h1 id="confirm-heading" class="hero-title is-compact">You're in — and I'm glad you're here.</h1>
      <p class="hero-lede">Keep an eye on your inbox — your first note is on its way. While you wait, take a look through what's below: the systems, favorites, and shelf picks that actually earn their place in our house.</p>
      <div class="confirm-signoff">
        <Image src={portraitImage} width={104} height={104} alt="Lauren" />
        <span>Lauren</span>
      </div>
    </div>
    <div class="hero-media">
      <figure class="photo is-square" aria-label="An envelope, for the weekly note">
        <svg viewBox="0 0 1040 1040" role="img" aria-hidden="true">
          <rect width="1040" height="1040" fill="var(--forest)" />
          <rect x="160" y="175" width="720" height="490" fill="var(--olive)" stroke="var(--sage-400)" stroke-opacity="0.3" stroke-width="2" />
          <path d="M160,175 L880,175 L520,415 Z" fill="var(--olive-deep)" />
          <circle cx="520" cy="415" r="55" fill="var(--clay)" />
          <text x="520" y="433" text-anchor="middle" font-family="'Fraunces', Georgia, serif" font-weight="700" font-size="46" fill="var(--chalk)">M</text>
          <text x="520" y="778" text-anchor="middle" font-family="'Fraunces', Georgia, serif" font-weight="500" font-size="52" fill="var(--chalk)">Meaningfully <tspan font-style="italic" font-weight="400" fill="var(--sage-400)">Messy</tspan></text>
          <line x1="465" y1="812" x2="575" y2="812" stroke="var(--sage-400)" stroke-opacity="0.5" stroke-width="1.5" />
          <text x="520" y="858" text-anchor="middle" font-family="ui-monospace, Menlo, monospace" font-size="15" letter-spacing="4" fill="var(--sage-400)" fill-opacity="0.85">THE WEEKLY NOTE</text>
        </svg>
      </figure>
    </div>
  </section>

  <ShopRecommendations instagramImage={portraitLargeImage} />
</Layout>
