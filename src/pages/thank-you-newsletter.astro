---
import Layout from '../layouts/Layout.astro';
import ShopRecommendations from '../components/ShopRecommendations.astro';
import { Image } from 'astro:assets';
import portraitImage from '../assets/images/portrait.jpg';
import portraitLargeImage from '../assets/images/portrait-large.jpg';
---
<Layout
  title="You're in — Meaningfully Messy"
  description="Thanks for joining the weekly note. While your first issue lands, here's what actually gets used around our house."
>
  <section class="hero wrap" aria-labelledby="confirm-heading">
    <div>
      <hr class="kicker-rule" />
      <h1 id="confirm-heading" class="hero-title is-compact">You're in — and I'm glad you're here.</h1>
      <p class="hero-lede">Keep an eye on your inbox — your first note is on its way. While you wait, take a look through what's below: the systems, favorites, and shelf picks that actually earn their place in our house.</p>
      <div class="confirm-signoff">
        <Image src={portraitImage} width={104} height={104} alt="Lauren" />
        <span>Lauren</span>
      </div>
    </div>
    <div class="hero-media">
      <figure class="photo">
        <Image src={portraitLargeImage} alt="Portrait of Lauren smiling in her garden" loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <ShopRecommendations />
</Layout>
