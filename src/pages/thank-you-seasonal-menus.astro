---
import Layout from '../layouts/Layout.astro';
import ShopRecommendations from '../components/ShopRecommendations.astro';
import { Image } from 'astro:assets';
import portraitImage from '../assets/images/portrait.jpg';
import portraitLargeImage from '../assets/images/portrait-large.jpg';
---
<Layout
  title="Your seasonal menu is ready — Meaningfully Messy"
  description="Your seasonal menu is ready to download — here's what actually gets used around our house too."
>
  <section class="hero wrap" aria-labelledby="confirm-heading">
    <div>
      <hr class="kicker-rule" />
      <h1 id="confirm-heading" class="hero-title is-compact">Your seasonal menu is ready.</h1>
      <p class="hero-lede">It's the same four weeks of dinners we're actually eating this season, grocery list included.</p>
      <a class="cta-button" href="/downloads/seasonal-menus-printable.pdf" target="_blank" rel="noopener">Download the printable (PDF)</a>
      <p class="hero-lede">Then take a look through what's below: the systems, favorites, and shelf picks that actually earn their place in our house.</p>
      <div class="confirm-signoff">
        <Image src={portraitImage} width={104} height={104} alt="Lauren" />
        <span>Lauren</span>
      </div>
    </div>
    <div class="hero-media">
      <figure class="photo">
        <Image src={portraitLargeImage} alt="Portrait of Lauren smiling in her garden" loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <ShopRecommendations />
</Layout>
