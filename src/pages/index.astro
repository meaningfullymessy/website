---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero.jpg';
import portraitLargeImage from '../assets/images/portrait-large.jpg';
---
<Layout
  title="Meaningfully Messy — Practical motherhood for a full house"
  description="Lauren became a mom to four kids in 2.5 years. Simple rhythms for a meaningful, manageable home — the small systems and mindset shifts that help a full house feel more peaceful."
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow">Practical motherhood for a full house</p>
      <h1 id="hero-title" class="hero-title">Life with kids is messy.<br /><em>Let's make it meaningful.</em></h1>
      <p class="hero-lede">Simple rhythms for a meaningful, manageable home. I'm Lauren — mom to four in 2.5 years — sharing the small systems and mindset shifts that help our full house feel more peaceful.</p>
      <div class="hero-ctas">
        <a href="#newsletter" class="cta-button">Get the weekly note</a>
        <a href="#about" class="link-underline">Read my story</a>
      </div>
    </div>
    <div class="hero-media">
      <figure class="photo">
        <Image src={heroImage} alt="Lauren and her husband embraced by their four children in a garden" fetchpriority="high" loading="eager" />
      </figure>
      <blockquote class="pull-quote">
        <p>&ldquo;Four tiny humans call this place home.&rdquo;</p>
      </blockquote>
    </div>
  </section>

  <section class="brand-truth">
    <div class="wrap">
      <div>
        <p class="eyebrow">The honest truth</p>
        <h2>A peaceful home isn't a home without mess.</h2>
      </div>
      <div>
        <p class="lead">It's a home with enough rhythm, shared responsibility, and grace that the mess doesn't become the whole story.</p>
        <hr class="rule" />
        <p class="body">Life with children is full, noisy, beautiful, and unfinished. I don't want to spend their childhood trying to erase the evidence that they live here. I want rhythms that keep our home from owning us, systems that make room for rest, and habits that teach our children they belong in the work and joy of family life.</p>
        <p class="body">I'm not offering a perfect home or a perfect mother. I'm learning, growing, and sharing the small choices that help a full house feel more peaceful and meaningful.</p>
      </div>
    </div>
  </section>

  <section id="share" class="section wrap" aria-labelledby="share-title">
    <div class="section-head">
      <h2 id="share-title">What I share</h2>
      <p>Four threads, one promise: one practical idea, and more grace for the home you're already building.</p>
    </div>
    <div class="cards-grid">
      <article class="card">
        <span class="card-number">01</span>
        <h3>Rhythms &amp; systems</h3>
        <p>The nighttime reset, mornings, laundry, meals, leaving the house, toy rotation, chores, couple teamwork. The version that works in a real house.</p>
      </article>
      <article class="card">
        <span class="card-number">02</span>
        <h3>Intentional motherhood</h3>
        <p>Kids helping, slowing down, children as whole people, peace over perfection. I could do it faster without them. That's not really the point.</p>
      </article>
      <article class="card">
        <span class="card-number">03</span>
        <h3>Homeschool in real life</h3>
        <p>Room setup, curriculum choices, read-alouds, recitation, and how lessons actually go with younger siblings nearby.</p>
      </article>
      <article class="card">
        <span class="card-number">04</span>
        <h3>Faith &amp; ordinary home life</h3>
        <p>Scripture, books, gardening, chickens, simple food, homemaking — faith practiced in everyday rhythms, not only formal lessons.</p>
      </article>
    </div>
    <p class="section-note">You don't need to do more. You need better rhythms that make room for what matters.</p>
  </section>

  <section id="newsletter" class="newsletter">
    <div class="wrap">
      <div>
        <p class="eyebrow">The weekly note</p>
        <h2>A few things worth knowing, once a week.</h2>
        <hr class="rule" />
        <p class="lede">Every week I send a few things from around here: a system that's working, a rhythm we're trying, a meaningful quote, a fresh perspective on a hard moment. Short and specific. Five minutes to read. Nothing to keep up with.</p>
        <ul class="belief-list">
          <li>Feels like a note from a friend, not a chore</li>
          <li>A few short things, not a long read</li>
          <li>Unsubscribe any time, no hard feelings</li>
        </ul>
      </div>
      <div class="newsletter-card">
        <h3>Join the weekly note.</h3>
        <p>Add your email and the next issue comes to you soon.</p>

        <form id="newsletter-form" class="opt-in-fields" novalidate>
          <div class="opt-in-field">
            <label for="newsletter-email">Email</label>
            <input id="newsletter-email" name="email" type="email" placeholder="you@email.com" autocomplete="email" required />
          </div>
          <button type="submit" class="cta-button is-full">Send me the weekly note</button>
          <p class="form-note">One email a week. No spam, unsubscribe anytime.</p>
          <p class="form-note" role="status" aria-live="polite" id="newsletter-status"></p>
        </form>
      </div>
    </div>
  </section>

  <section id="about" class="section wrap" aria-labelledby="about-title">
    <div class="about-split">
      <div class="hero-media">
        <figure class="photo">
          <Image src={portraitLargeImage} alt="Portrait of Lauren smiling in her garden" loading="lazy" />
        </figure>
      </div>
      <div>
        <p class="eyebrow">About</p>
        <h2 id="about-title" class="section-title">I'm Lauren, a homeschooling mom of four.</h2>
        <p class="hero-lede">I believe a peaceful home isn't a perfect or quiet one. Around here I share the simple rhythms that help our full house work, the mindset shifts that keep people more important than appearances, and what homeschooling looks like in real life.</p>
        <p class="body-copy">The name is personal — a play on Messmer — but it also says the thing I keep coming back to: the home can be unfinished, noisy, and lived-in while the choices inside it are deeply intentional. Systems serve people, never the other way around.</p>
        <p class="signature">Little by little, one travels far.</p>
      </div>
    </div>
  </section>

  <section class="beliefs">
    <div class="wrap">
      <div>
        <p class="eyebrow">What I believe</p>
        <ul class="belief-list">
          <li>Systems serve people — never the other way around.</li>
          <li>Peace isn't the same as quiet or spotless.</li>
          <li>Children belong in the work and joy of family life.</li>
          <li>Ordinary motherhood is worthy of attention.</li>
          <li>Intentional doesn't mean rigid.</li>
          <li>Faith belongs in everyday rhythms, not only formal lessons.</li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">What I refuse</p>
        <ul class="belief-list refuse">
          <li>Perfection performed as motherhood.</li>
          <li>Chaos treated as a permanent identity.</li>
          <li>Efficiency that treats children as interruptions.</li>
          <li>Rigid schedules presented as moral superiority.</li>
        </ul>
        <p class="tagline">Jesus &gt; everything. Family &gt; self. Growth &gt; perfection.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const status = document.getElementById('newsletter-status');

  form.addEventListener('submit', (event) => {
    event.preventDefault();

    const emailInput = form.elements.namedItem('email') as HTMLInputElement;
    const email = emailInput.value.trim();

    if (!email) {
      if (status) status.textContent = 'Please enter your email.';
      return;
    }

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitButton.disabled = true;
    if (status) status.textContent = '';

    // Posts to our own Cloudflare Pages Function (functions/api/subscribe.js),
    // which holds the Kit API key server-side — never in this client code.
    // Awaited (unlike the inline-success pages) because the destination
    // we're about to navigate to is the confirmation itself — a failed
    // subscribe should surface here rather than send someone to a "you're
    // in" page they never actually joined from.
    fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, source: 'newsletter' }),
    })
      .then((res) => {
        if (!res.ok) throw new Error(`subscribe failed: ${res.status}`);
        window.location.href = '/thank-you-newsletter';
      })
      .catch((err) => {
        console.error('Subscribe request failed:', err);
        submitButton.disabled = false;
        if (status) status.textContent = 'Something went wrong — please try again.';
      });
  });
</script>
