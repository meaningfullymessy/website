# Cloudflare Pages headers config: https://developers.cloudflare.com/pages/configuration/headers/
# Long-lived, immutable caching for assets that never change in place — a
# content change always ships under a new filename (Astro content-hashes
# /_astro/*, and the font/image files below are only ever replaced wholesale).

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/logo/*
  Cache-Control: public, max-age=31536000, immutable

/assets/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/downloads/*
  Cache-Control: public, max-age=604800
